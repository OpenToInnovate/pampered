{
  "name": "pampered",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A dog-friendly business finder with a map, at pampered.korg-e.com",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit && node scripts/validate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "refresh": "node scripts/refresh-osm.mjs",
    "build:index": "node scripts/build-index.mjs",
    "sync": "node scripts/sync-d1.mjs",
    "db:schema:local": "wrangler d1 execute pampered --local --file schema.sql",
    "db:schema:remote": "wrangler d1 execute pampered --remote --file schema.sql",
    "precheck": "npm run cf-typegen",
    "prebuild": "npm run cf-typegen"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.6",
    "maplibre-gl": "^6.14.0",
    "miniflare": "^5.20261012.0-beta",
    "nitro": "^3.0.260903-beta",
    "solid-js": "^1.9.17",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.2",
    "miniflare": "^5.20261012.0-beta",
    "nitro": "^3.0.260903-beta",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
